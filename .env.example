# Neon connection string for SQLAlchemy + psycopg 3.
# Use the POOLED hostname (it has the "-pooler" suffix) from the Neon console:
#   Connect -> toggle "Connection pooling" ON -> copy the connection string.
# Then swap the scheme from postgresql:// to postgresql+psycopg:// and add sslmode=require.
DATABASE_URL="postgresql+psycopg://user:password@ep-xxxx-aaaa-pooler.ap-southeast-1.aws.neon.tech/dbname?sslmode=require"

# LLM provider key used by both notebooks (OpenAI by default; swap providers in the notebook cells).
OPENAI_API_KEY="sk-..."

# Langfuse observability (https://langfuse.com) — tracing for both notebooks.
# The LangChain notebook uses the native CallbackHandler; the LlamaIndex notebook
# routes OpenInference OTel spans to Langfuse. Both need the same three values.
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"   # US cloud: https://us.cloud.langfuse.com

# Optional but recommended for the LangChain notebook: trace every agent run step-by-step.
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="ls__..."
